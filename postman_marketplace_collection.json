								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"display_name\": \"Bay Area Dermatology & Laser Center\",\n  \"phone_e164\": \"+14155552345\",\n  \"addr_line1\": \"400 Parnassus Ave Suite 100\",\n  \"city\": \"San Francisco\",\n  \"state\": \"CA\",\n  \"zip\": \"94143\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/providers/1",
