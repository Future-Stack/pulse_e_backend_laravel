{
	"info": {
		"_postman_id": "pulse-e-marketplace-api-v1",
		"name": "Pulse_E Provider Marketplace APIs",
		"description": "Complete Postman collection for testing and integrating Pulse_E Provider Marketplace APIs (Public Marketplace & Admin Portal). Note: Admin endpoints require a Sanctum token from a user with is_marketplace_admin = 1.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Public Marketplace APIs",
			"item": [
				{
					"name": "Get Provider Slate",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/marketplace/slate?category=obgyn&zip=94105",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"marketplace",
								"slate"
							],
							"query": [
								{
									"key": "category",
									"value": "obgyn",
									"description": "Required: Provider category slug (e.g. obgyn, dermatology, physical-therapist-sports, pelvic-floor-pt)"
								},
								{
									"key": "zip",
									"value": "94105",
									"description": "Required (unless metro_id supplied): 5-digit US ZIP code"
								},
								{
									"key": "metro_id",
									"value": "1",
									"description": "Required (unless zip supplied): Specific Metro ID",
									"disabled": true
								},
								{
									"key": "life_stage",
									"value": "beauty-radiance",
									"description": "Optional: Filter by life stage slug (e.g. beauty-radiance, cycle-fertility, athlete)",
									"disabled": true
								},
								{
									"key": "limit",
									"value": "3",
									"description": "Optional: Number of results (1 to 5, default: 3)",
									"disabled": true
								}
							]
						},
						"description": "Returns ranked organic and sponsored providers for a metro area and category."
					},
					"response": []
				},
				{
					"name": "Log Slate Events (Analytics)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"session_token\": \"a1b2c3d4e5f678901234567890abcdef\",\n  \"events\": [\n    {\n      \"event_type\": \"impression\",\n      \"category\": \"obgyn\",\n      \"metro_id\": 1,\n      \"provider_id\": 1,\n      \"slot_position\": 1,\n      \"sponsored\": false,\n      \"occurred_at\": \"2026-08-18T09:00:00Z\"\n    },\n    {\n      \"event_type\": \"tap\",\n      \"category\": \"obgyn\",\n      \"metro_id\": 1,\n      \"provider_id\": 1,\n      \"slot_position\": 1,\n      \"sponsored\": false,\n      \"occurred_at\": \"2026-08-18T09:01:00Z\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/marketplace/events",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"marketplace",
								"events"
							]
						},
						"description": "Submits batch analytics events (impression, tap, call, directions, website, share) for marketplace slates."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Admin - Provider Management",
			"item": [
				{
					"name": "List Providers",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/providers?status=active",
