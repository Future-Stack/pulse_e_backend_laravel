								"v1",
								"admin",
								"providers"
							],
							"query": [
								{
									"key": "status",
									"value": "active",
									"description": "Filter by status: candidate, vetted, active, suspended"
								},
								{
									"key": "search",
									"value": "Dermatology",
									"description": "Search by provider name, NPI, or city",
									"disabled": true
								},
								{
									"key": "metro_id",
									"value": "1",
									"disabled": true
								}
							]
						},
						"description": "List all providers with filters for status and search terms (Requires user with is_marketplace_admin = 1)."
					},
					"response": []
				},
